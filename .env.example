# ─────────────────────────────────────────────────────────────
# Genesis — variáveis de ambiente (copie para .env e ajuste)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────────────
# Porta 5440 no host (mapeada p/ 5432 do container) para evitar conflito local.
DATABASE_URL=postgresql://genesis:genesis@localhost:5440/genesis?schema=public

# ── Cache / Filas (Redis + BullMQ) ──────────────────────────
REDIS_URL=redis://localhost:6380

# ── Vetorial / RAG (Qdrant) ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Storage (S3 compatível / MinIO) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=genesis
S3_SECRET_KEY=genesis-secret
S3_BUCKET=genesis

# ── Auth (JWT) ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=28800
JWT_REFRESH_TTL=2592000

# ── API ─────────────────────────────────────────────────────
API_PORT=3333
API_GLOBAL_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
APP_URL=http://localhost:3000

# ── E-mail (Mailhog em dev; SMTP real em prod) ───────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Genesis <noreply@genesis.dev>

# ── Provedores de IA (Anthropic primário; demais fallback) ──
AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_ORDER=anthropic,openai,gemini,openrouter,ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
